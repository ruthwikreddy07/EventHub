# EventHub Backend - Environment Variables Template
# Copy this file to '.env' and fill in your actual credentials.

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/eventhub?retryWrites=true&w=majority

# Port for the Express server to run on
PORT=5000

# JSON Web Token (JWT) secret key (use a strong random string)
JWT_SECRET=your_jwt_secret_key_here

# Stripe Secret Key (from Stripe Developer Dashboard -> API Keys)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Frontend Application URL (for Stripe redirection)
FRONTEND_URL=http://localhost:4200
